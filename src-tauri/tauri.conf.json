{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniPanel",
  "version": "1.42.0",
  "identifier": "ru.shokydo.omnipanel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/tray-idle.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "copyright": "OmniPanel",
    "shortDescription": "Панель управления серверами",
    "windows": {
      "nsis": {
        "languages": ["Russian"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
